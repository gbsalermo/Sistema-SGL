{
  "info": {
    "_postman_id": "pedido-collection-001",
    "name": "SGL - Pedidos API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Criar Pedido",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuarioId\": 4,\n  \"laboratorioId\": 3,\n  \"projetoId\": 1,\n  \"observacao\": \"Pedido de teste via Postman\",\n  \"itens\": [\n    { \"produtoId\": 1, \"quantidadeSolicitada\": 2 },\n    { \"produtoId\": 5, \"quantidadeSolicitada\": 1 }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos"] }
      }
    },
    {
      "name": "Listar Todos Pedidos",
      "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos"] } }
    },
    {
      "name": "Buscar Pedido por ID",
      "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos","{{pedidoId}}"] } }
    },
    {
      "name": "Listar por Usuário",
      "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/v1/pedidos/por-usario?usuarioId={{usuarioId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos","por-usario"], "query": [ { "key": "usuarioId", "value": "{{usuarioId}}" } ] } }
    },
    {
      "name": "Listar por Status",
      "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/v1/pedidos/por-status?status=PENDENTE", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos","por-status"], "query": [ { "key": "status", "value": "PENDENTE" } ] } }
    },
    {
      "name": "Aprovar Pedido",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"itens\": [\n    { \"itemId\": 1, \"quantidadeAprovada\": 2 }\n  ],\n  \"observacao\": \"Aprovado via Postman\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}/aprovar", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos","{{pedidoId}}","aprovar"] }
      }
    },
    {
      "name": "Rejeitar Pedido",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}/rejeitar?observacao=Motivo+da+rejeicao", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos","{{pedidoId}}","rejeitar"], "query": [ { "key": "observacao", "value": "Motivo da rejeicao" } ] }
      }
    },
    {
      "name": "Entregar Pedido",
      "request": { "method": "PUT", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}/entregar", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos","{{pedidoId}}","entregar"] } }
    },
    {
      "name": "Cancelar Pedido",
      "request": { "method": "PUT", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}/cancelar?observacao=Motivo+cancelamento", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos","{{pedidoId}}","cancelar"], "query": [ { "key": "observacao", "value": "Motivo cancelamento" } ] } }
    },
    {
      "name": "Deletar Pedido",
      "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","pedidos","{{pedidoId}}"] } }
    }
  ]
}
