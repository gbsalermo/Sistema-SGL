@startuml Sequencia_Pedido

' ============================================
' Diagrama de Sequência - Fluxo de Pedido
' Projeto STOCK
' ============================================

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title Diagrama de Sequência - Fluxo de Pedido

actor Pesquisador as P
actor Gestor as G
participant "Frontend\n(Vue.js)" as FE
participant "API\n(Spring Boot)" as API
database "Banco de Dados\n(PostgreSQL)" as DB

== Pesquisador Faz Pedido ==

P -> FE: Acessa "Fazer Pedido"
activate FE

FE -> API: GET /api/v1/laboratorios
activate API
API -> DB: Buscar laboratórios do usuário
DB --> API: Lista de laboratórios
API --> FE: Retorna laboratórios
deactivate API

FE -> P: Exibe formulário
P -> FE: Seleciona laboratório

FE -> API: GET /api/v1/projetos
activate API
API -> DB: Buscar projetos da unidade
DB --> API: Lista de projetos
API --> FE: Retorna projetos
deactivate API

FE -> P: Exibe lista de projetos
P -> FE: Seleciona projeto (opcional)

FE -> API: GET /api/v1/produtos
activate API
API -> DB: Buscar produtos disponíveis
DB --> API: Lista de produtos
API --> FE: Retorna produtos
deactivate API

FE -> P: Exibe catálogo de produtos
P -> FE: Seleciona itens e quantidades

FE -> P: Exibe alerta estoque baixo
note right: Se quantidade ≤ mínima\nexibe aviso

P -> FE: Confirma pedido
FE -> API: POST /api/v1/pedidos
activate API

API -> DB: Inserir pedido
DB --> API: Pedido criado (PENDENTE)
API -> DB: Inserir itens do pedido
DB --> API: Itens salvos
API --> FE: Pedido criado com sucesso
deactivate API

FE -> P: Exibe confirmação
deactivate FE

== Gestor Aprova/Rejeita Pedido ==

G -> FE: Acessa "Pedidos Pendentes"
activate FE

FE -> API: GET /api/v1/pedidos?status=PENDENTE
activate API
API -> DB: Buscar pedidos pendentes
DB --> API: Lista de pedidos
API --> FE: Retorna pedidos
deactivate API

FE -> G: Exibe lista de pedidos
G -> FE: Seleciona pedido

FE -> API: GET /api/v1/pedidos/{id}
activate API
API -> DB: Buscar detalhes do pedido
DB --> API: Dados do pedido
API --> FE: Retorna pedido completo
deactivate API

FE -> G: Exibe detalhes do pedido
deactivate FE

alt Aprovar Pedido
    G -> FE: Clica "Aprovar"
    activate FE
    
    FE -> API: PUT /api/v1/pedidos/{id}/aprovar
    activate API
    
    API -> DB: Atualizar status para APROVADO
    DB --> API: Status atualizado
    
    API -> DB: Baixar estoque (itens)
    loop Para cada item do pedido
        API -> DB: Atualizar quantidade do produto
        DB --> OK
        API -> DB: Registrar movimentação SAÍDA
        DB --> OK
    end
    
    API --> FE: Pedido aprovado
    deactivate API
    
    FE -> G: Exibe confirmação
    deactivate FE

else Rejeitar Pedido
    G -> FE: Clica "Rejeitar"
    activate FE
    
    FE -> P: Solicita justificativa
    P -> FE: Informa motivo
    
    FE -> API: PUT /api/v1/pedidos/{id}/rejeitar
    activate API
    
    API -> DB: Atualizar status para REJEITADO
    DB --> API: Status atualizado
    
    API --> FE: Pedido rejeitado
    deactivate API
    
    FE -> G: Exibe confirmação
    deactivate FE
end

== Entrega do Material ==

G -> FE: Acessa "Pedidos Aprovados"
activate FE

FE -> API: GET /api/v1/pedidos?status=APROVADO
activate API
API -> DB: Buscar pedidos aprovados
DB --> API: Lista de pedidos
API --> FE: Retorna pedidos
deactivate API

FE -> G: Exibe lista de pedidos
G -> FE: Seleciona pedido para entregar

FE -> API: PUT /api/v1/pedidos/{id}/entregar
activate API

API -> DB: Atualizar status para ENTREGUE
DB --> API: Status atualizado

API --> FE: Entrega registrada
deactivate API

FE -> G: Exibe confirmação
deactivate FE

@enduml
