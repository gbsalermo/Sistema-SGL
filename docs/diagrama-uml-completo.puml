@startuml
title SGL — Diagrama UML Completo
skinparam classAttributeIconSize 0
\n' Entities
class Unidade {
  +Long id
  +String nome
  +String sigla
}

class Laboratorio {
  +Long id
  +String nome
  +String descricao
  +Boolean ativo
}

class Usuario {
  +Long id
  +String nome
  +String email
  +String senha
  +Perfil perfil
  +Boolean ativo
}

class Projeto {
  +Long id
  +String nome
  +String descricao
  +Boolean ativo
}

class Produto {
  +Long id
  +String nome
  +String descricao
  +String codigoReferencia
  +UnidadeMedida unidadeMedida
  +String localizacaoFisica
  +NivelRisco risco
  +TipoRisco tipoRisco
  +String descricaoRisco
  +Boolean perecivel
  +TipoPerecivel tipoPerecivel
  +LocalDate dataValidade
  +String condicoesArmazenamento
  +String unidadeArmazenamento
  +Boolean ativo
}

class EstoqueCentral {
  +Long id
  +Integer quantidadeAtual
  +Integer quantidadeMinima
  +Boolean ativo
}

class Pedido {
  +Long id
  +LocalDateTime dataSolicitacao
  +StatusPedido status
  +String observacao
  +String arquivoDocumento
}

class ItemPedido {
  +Long id
  +Integer quantidadeSolicitada
  +Integer quantidadeAprovada
}

class HistoricoLaboratorio {
  +Long id
  +Integer quantidade
  +LocalDate dataRecebimento
  +Boolean ativo
}

class Lote {
}

